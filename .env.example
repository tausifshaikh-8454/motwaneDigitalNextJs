# WordPress backend (headless CMS)
WP_BASE_URL=https://springgreen-snail-643250.hostingersite.com
WP_API_URL=https://springgreen-snail-643250.hostingersite.com/wp-json

# Public URL of this Next.js site — set to the real domain in production
